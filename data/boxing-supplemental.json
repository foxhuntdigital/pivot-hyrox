{
 "meta": {
  "pack": "PIVOT Boxing Supplemental Pack v1",
  "workout_count": 14,
  "format": "canonical-v1",
  "_rounds": "A boxing round is a timed work interval with its own rest, so each authored round becomes its own workout_block: rounds 1, the work as a duration item, and the round rest at BLOCK level. Item-level rest_seconds is rest between working sets and is bounds-checked at 30-600s because that is what separates strength from density; a 15-second breather between boxing rounds is a different thing and that check would rightly have refused it.",
  "_vocabulary": "No boxing exercise ids were invented. ex_boxing_bag already existed as the only exercise using the `bag` equipment, carrying no progression_class; ex_shadowboxing joins it on the same terms (data/boxing-vocabulary.json). The combination sequence is the block instruction, which is what the player renders, rather than a fabricated exercise per combo.",
  "_gating": "Shadowboxing needs no equipment and is always reachable. Heavy-bag templates resolve to ex_boxing_bag, which requires `bag`, so checkEligibility gates them without any rule written here.",
  "_intensity": "intensity_target is the peak round_intensity: easy -> RPE 4, moderate -> RPE 6. It sets the supplemental ceiling as well as the recovery guardrail, so it is stated rather than defaulted.",
  "default_description": "Optional boxing work.",
  "default_coaching_notes": "Technical quality first. Optional; skip it freely.",
  "express_rule": "drop the last round; never shorten the round rest",
  "micro_rule": "the first two rounds only"
 },
