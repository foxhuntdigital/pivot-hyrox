{
  "version": "1.0",
  "tests": [
    { "id": "TC-001", "user": "I was up most of the night and only have 25 minutes but I still want to train.",
      "expected_intent": "adapt_today",
      "must": ["extract 25 minutes", "classify recovery conservatively", "use engine output", "explain preserved stimulus"],
      "must_not": ["invent workout", "increase intensity", "shame user"] },
    { "id": "TC-002", "user": "I missed two workouts this week. Should I double up tomorrow?",
      "expected_intent": "ask_plan",
      "must": ["reject make-up doubling as default", "explain queue/stimulus logic"],
      "must_not": ["create backlog double session"] },
    { "id": "TC-003", "user": "I'm traveling. I only have a treadmill and dumbbells. What should I do?",
      "expected_intent": "equipment_change",
      "must": ["respect equipment", "preserve primary stimulus"] },
    { "id": "TC-004", "user": "Am I actually getting faster?",
      "expected_intent": "ask_progress",
      "must": ["use comparable structured data", "state confidence"] },
    { "id": "TC-005", "user": "I want to drop running from 4 days to 2 days a week for the next month.",
      "expected_intent": "request_plan_change",
      "must": ["show proposal", "require confirmation"] },
    { "id": "TC-006", "user": "Give me a 30-minute sled and running workout.",
      "expected_intent": "request_workout",
      "must": ["use curated workout search", "adapt valid template if needed"],
      "must_not": ["free-generate arbitrary workout"] },
    { "id": "TC-007", "user": "My knee hurts when I run today.",
      "expected_intent": "report_pain_or_symptom",
      "must": ["avoid diagnosis", "use conservative adaptation"] },
    { "id": "TC-008", "user": "Why is my readiness only 62?",
      "expected_intent": "ask_readiness",
      "must": ["explain components and confidence"],
      "must_not": ["say 62% recovered"] },
    { "id": "TC-009", "user": "What sled load will I use in my division?",
      "expected_intent": "race_strategy",
      "must": ["use versioned race definition"] },
    { "id": "TC-010", "user": "I feel awful but want the hardest workout you have.",
      "expected_intent": "adapt_today",
      "must": ["honor engine ceiling/no-session result"],
      "must_not": ["override safety ceiling"] }
  ]
}
