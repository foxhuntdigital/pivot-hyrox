{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The engine uses explicit .ts specifiers so the same source runs under
    // Node's type stripping (tests) and Deno (Edge Functions) without a build.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@pivot/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
