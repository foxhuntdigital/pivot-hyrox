# Copy to .env and fill in from the Supabase dashboard (Project settings → API).
# EXPO_PUBLIC_ is required for Expo to inline the value into the client bundle.
# The anon key is a public client key; the service_role key must never appear here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys, from Project settings → API keys → App-specific.
# A `test_` prefix is the Test Store (simulated purchases); `appl_`/`goog_` are
# the real stores. Public keys are designed to ship in the client.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
