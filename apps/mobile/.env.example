# Copy to .env and fill in from the Supabase dashboard (Project settings → API).
# EXPO_PUBLIC_ is required for Expo to inline the value into the client bundle.
# The anon key is a public client key; the service_role key must never appear here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Amplitude project API key (Settings -> Projects -> your project -> API Key).
# Use the DEV project's key here; production is set per EAS build profile.
# Left empty, analytics no-ops and the app behaves exactly as it did without it.
EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-dev-key
