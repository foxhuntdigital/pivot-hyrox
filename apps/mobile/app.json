{
  "expo": {
    "name": "PIVOT",
    "slug": "pivot",
    "scheme": "pivot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adaptiveathlete.pivot",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "workout-processing"
        ]
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.adaptiveathlete.pivot",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#201E1D"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F252C",
          "image": "./assets/splash-blank.png",
          "imageWidth": 1
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "PIVOT reads your resting heart rate, heart-rate variability, sleep and heart rate during sessions to adjust your training and show your heart rate while you work out.",
          "NSHealthUpdateUsageDescription": "PIVOT saves the sessions you complete, with their heart rate, so your Activity rings and Health history stay accurate."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15177b35-c97f-4a05-9006-f34a83a0b0a8"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
