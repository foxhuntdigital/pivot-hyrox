    "android": {
      "package": "com.adaptiveathlete.pivot",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15177b35-c97f-4a05-9006-f34a83a0b0a8"
      }
    }
  }
}
